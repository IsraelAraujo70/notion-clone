DATABASE_URL=postgres://postgres:postgres@localhost:55433/notion_clone
HOST=0.0.0.0
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_WEB_URL=http://localhost:3000
# Required in deployed environments. Generate with: openssl rand -base64 48
MCP_CURSOR_SIGNING_KEY=replace-with-a-long-random-secret
RESEND_API_KEY=
RESEND_FROM_EMAIL=Notion Clone <noreply@israeldeveloper.com.br>
NEXT_PUBLIC_API_BASE_URL=http://localhost:18080

# Object storage (S3-compatible). Local: MinIO via `make dev`.
# Prod (Railway): bucket S3 + mesmas vars com endpoint/credenciais do Railway.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=media
S3_REGION=us-east-1
S3_URL_STYLE=path
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/media

# AI via OpenRouter
OPENROUTER_API_KEY=
AI_CHAT_MODEL=openai/gpt-5.6-luna
AI_TITLE_MODEL=deepseek/deepseek-v4-flash
AI_EMBEDDING_MODEL=openai/text-embedding-3-large

# Optional GitHub App integration. Keep installation and OAuth tokens ephemeral.
# Configure the App setup URL as API_URL/integrations/github/setup and the
# callback URL as API_URL/integrations/github/callback.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_API_URL=https://api.github.com

# Optional Google Calendar read-only integration. The first encryption key is
# active; keep older keys after commas while rotating existing ciphertext.
# Generate a key with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_ENCRYPTION_KEYS=key-2026-01:BASE64URL_32_BYTE_KEY
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:18080/integrations/google-calendar/oauth/callback
GOOGLE_CALENDAR_WEBHOOK_URL=https://YOUR_PUBLIC_API/integrations/google-calendar/webhook
GOOGLE_CALENDAR_WORKER_INTERVAL_SECONDS=10
GOOGLE_CALENDAR_SYNC_BATCH_SIZE=20
NEXT_PUBLIC_GOOGLE_CALENDAR_ENABLED=true
